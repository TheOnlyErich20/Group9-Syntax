-- Enable Row Level Security on the storage.objects table
ALTER TABLE storage.objects ENABLE ROW LEVEL SECURITY;

-- Policy for files bucket: Users can only access files in paths containing their UID
-- This ensures students can only upload/download their own submissions
-- Path structure: subjectId/taskId/submissions/userId/filename
CREATE POLICY "Users can access files with their UID in path" ON storage.objects
FOR ALL USING (
  bucket_id = 'files'
  AND auth.uid()::text = (string_to_array(name, '/'))[4]  -- UID is at index 4 in path
);

-- Allow instructors to access all files in their course
-- Note: This requires additional logic to check course membership, but for simplicity:
-- Instructors can access files where the path starts with their course
CREATE POLICY "Instructors can access course files" ON storage.objects
FOR ALL USING (
  bucket_id = 'files'
  -- Placeholder: Add logic to check if user is instructor
  -- AND EXISTS (SELECT 1 FROM user_roles WHERE user_id = auth.uid() AND role = 'instructor')
);

-- Allow public read access for files (since URLs are public)
-- But restrict based on path containing user's UID
CREATE POLICY "Public read for own files" ON storage.objects
FOR SELECT USING (
  bucket_id = 'files'
  AND auth.uid()::text = (string_to_array(name, '/'))[4]
);

-- Allow users to upload files (remove auth checks for INSERT to allow uploads with Firebase auth)
CREATE POLICY "Users can upload" ON storage.objects
FOR INSERT WITH CHECK (
  bucket_id = 'files'
);

-- Allow users to update/delete their own files
CREATE POLICY "Users can modify own files" ON storage.objects
FOR UPDATE USING (
  bucket_id = 'files'
  AND auth.uid()::text = (string_to_array(name, '/'))[4]
);

CREATE POLICY "Users can delete own files" ON storage.objects
FOR DELETE USING (
  bucket_id = 'files'
  AND auth.uid()::text = (string_to_array(name, '/'))[4]
);
